API_BASE_URL=https://api.votredomaine.com

APP_URL=https://app.votredomaine.com
APP_NAME=httpSMS
APP_GITHUB_URL=https://github.com/NdoleStudio/httpsms
APP_DOCUMENTATION_URL=https://docs.httpsms.com
APP_DOWNLOAD_URL=
APP_ENV=production

# Facturation Lemonsqueezy du SaaS d'origine — laissez vide si vous ne l'utilisez pas
CHECKOUT_URL=
ENTERPRISE_CHECKOUT_URL=

# Config web SDK de VOTRE projet Firebase (Firebase Console > Project settings > General)
# Ce ne sont pas des secrets (clés publiques côté client), mais elles doivent pointer
# vers votre propre projet, pas celui du SaaS httpsms.com.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

CLOUDFLARE_TURNSTILE_SITE_KEY=

PUSHER_KEY=
PUSHER_CLUSTER=
