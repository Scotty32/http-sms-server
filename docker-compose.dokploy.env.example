# Variables à coller dans l'onglet "Environment" de l'app Compose "http-sms" sur Dokploy.
#
# Dokploy écrit ces valeurs dans un .env à côté de docker-compose.dokploy.yml au moment
# du build/deploy. Seules les variables ci-dessous sont réellement lues par ce fichier
# (${VAR}) — tout le reste (DATABASE_URL, REDIS_URL, EVENTS_QUEUE_*, ENV, APP_PORT,
# WEBHOOK_TEST_ALLOW_PRIVATE_IPS, etc.) est codé en dur dans le compose et n'a pas besoin
# d'être défini ici.

# --- Postgres (service "postgres") ---
POSTGRES_DB=comunicator-sms
POSTGRES_USER=comunicator-sms
POSTGRES_PASSWORD=

# --- API ---

# ID du projet Firebase/GCP (Firebase Console > Paramètres du projet > Général)
GCP_PROJECT_ID=

# Contenu JSON complet du fichier de service account Firebase, sur une seule ligne
# Firebase Console > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
# ex: FIREBASE_CREDENTIALS='{ "type": "service_account", "project_id": "...", ... }'
FIREBASE_CREDENTIALS=

# Utilisateur admin système utilisé pour authentifier les requêtes internes vers /v1/events.
# À créer dans la table `users`/`apps` de la base de PROD une fois l'app démarrée,
# puis redéployer avec ces deux valeurs renseignées.
EVENTS_QUEUE_USER_API_KEY=
EVENTS_QUEUE_USER_ID=

# Secret envoyé dans le header x-webhook-secret pour les callbacks de livraison v2.
# Générer une vraie valeur aléatoire, ne PAS laisser "change-me-in-production".
SMS_WEBHOOK_SECRET=

# Secret de signature des sessions/JWT — une vraie valeur aléatoire, unique à cet environnement.
JWT_SECRET=

# Domaine public de l'API (utilisé pour le host affiché dans Swagger UI)
SWAGGER_HOST=sms-api.om-ci.org

# URL publique de l'application web (utilisée pour générer les liens dans les emails).
# En https:// si Dokploy/Traefik termine le TLS sur ce domaine.
APP_URL=https://sms.om-ci.org

# [optionnel] nom/branding de l'app — défaut "httpSMS" si vide
APP_NAME=httpSMS

# --- SMTP (envoi d'emails) ---
SMTP_FROM_NAME=httpSMS
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587

# --- [optionnel] Uptrace (tracing distribué) ---
UPTRACE_DSN=

# --- [optionnel] Pusher (mises à jour temps réel du frontend) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- [optionnel] Durée de session — défaut 720h (30 jours) si vide ---
SESSION_DURATION=720h

# --- [optionnel] Commit git injecté au build — laisser vide, Dokploy/CI peut le renseigner ---
GIT_COMMIT=
